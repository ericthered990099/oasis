# Oasis Website Environment Variables
# Copy this file to .env.local and fill in your values

# Vercel Deployment URL (auto-set by Vercel)
VERCEL_URL=

# App URLs
NEXT_PUBLIC_APP_URL=https://app.oasis-recovery.com
NEXT_PUBLIC_WEBSITE_URL=https://oasis-recovery.com

# Analytics (optional, when added)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Email Configuration (when adding backend)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hello@oasis-recovery.com

# Contact Form (when adding backend)
# CONTACT_EMAIL_TO=hello@oasis-recovery.com

# Newsletter Integration (when added)
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=

# Feature Flags
# NEXT_PUBLIC_BLOG_ENABLED=true
# NEXT_PUBLIC_NEWSLETTER_ENABLED=true
# NEXT_PUBLIC_CONTACT_FORM_ENABLED=true
